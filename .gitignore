# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test and coverage artifacts (pytest, pytest-cov / coverage.py)
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# Tool caches (Ruff, pyright)
.ruff_cache/

# OS / editor clutter
Thumbs.db
Desktop.ini
.DS_Store

# VS Code: commit only the shared workspace config; anything else VS Code or an
# extension writes into .vscode/ is per-user and stays local.
# Pattern: https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Claude Code: personal overrides stay local (shared config in .claude/ is committed)
.claude/settings.local.json

# Working implementation plans for in-progress branches; local only, never
# committed. Durable decisions go in docs/adr/.
.plans/
